# 境途同游 — 环境变量示例
# 复制为 .env 后按实际情况填写。带 *** 的项目必须自行生成，不要沿用示例值。

# ==================== 数据库 ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jingtu_group

# ==================== 安全 ====================
# 会话签名密钥，务必替换为随机长字符串：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# VRChat Cookie 的 AES-256-GCM 加密密钥，同样必须随机且长度足够
ENCRYPT_KEY=
# 数据库恢复令牌：用于「脱离登录的自救通道」(/api/system/db-recover) 的写操作鉴权。
# 强烈建议使用 ≥32 字节随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未配置时，恢复写接口一律返回 503（通道不可用，且无鉴权保护），防止公网任意访客在系统故障时接管数据库配置。
RECOVERY_TOKEN=
# 跨域白名单（逗号分隔的完整 Origin，如 https://a.com,https://b.com）。
# 安全默认：留空/不设置 = 拒绝所有跨域请求（仅同源可用），启动时会打 warn 提示。
# 这是刻意设计，不是缺陷——不要图省事填 *（带 credentials 的 CORS 用 * 本来也无效）。
CORS_ORIGINS=

# ==================== 服务 ====================
NODE_ENV=production
PORT=3456
LOG_LEVEL=INFO

# ==================== 反代与客户端 IP ====================
# 服务器前面有 Nginx / 宝塔 / Docker 等反向代理时，req.ip、按 IP 的登录限流与
# 安全告警都依赖此设置。
# 安全默认：留空/不设置 = 不信任任何代理（等价 TRUST_PROXY=false），防止端口直接
#   暴露公网时客户端伪造 X-Forwarded-For 绕过限流、污染审计 IP——刻意设计，非缺陷。
# 有反代却不设置的后果：所有请求的客户端 IP 坍缩为 127.0.0.1，登录暴破/限流按
#   IP 计数会全员互伤，审计日志与安全告警里的 IP 全部失真。
# 取值：
#   TRUST_PROXY=1        信任 1 层反代（Nginx/宝塔单机反代填 1）
#   TRUST_PROXY=2        反代前还有 CDN 等一层时按实际跳数填写
#   TRUST_PROXY=false/0  显式关闭；端口直接暴露公网、前面无可信反代时必须保持关闭
#   亦支持 Express trust proxy 原语：loopback、unix、逗号分隔的网段/跳数列表
TRUST_PROXY=

# ==================== 缓存 Redis ====================
# 留空（不设置 REDIS_HOST）即完全关闭 Redis，缓存/限流/CSRF 全部走进程内实现，行为与未接入 Redis 时一致。
# 只有配置了 REDIS_HOST 才会连接；连接失败不会阻断启动，运行时自动降级回本地实现。
# 开启后获得：接口限流计数跨实例共享（键前缀 rl:<limiter名>:）、CSRF token 跨实例可校验（键 csrf:<token>）。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== VRChat 群组 ====================
GROUP_ID=
VRC_GROUP_URL=
VRC_API_KEY=

# ==================== 外部社区链接 ====================
KOOK_URL=
OOPZ_URL=

# ==================== 直播推流（RTMP / HLS）====================
# ⚠️ 当前直播功能整体下线（docs/19 P1-5：缺外部 RTMP/HLS 转码管线）：
#   前端入口经 loader.js DISABLED_FEATURES 隐藏，服务端 /api/live 已卸载，
#   路由归档于 server/routes/_archive/live.js。以下变量暂不生效，保留备复活。
# 这些值决定"开始直播"弹窗里给出的 OBS 推流地址。
# 未配置 RTMP_HOST 时会退回到当前请求的主机名，本地调试可以留空；
# 但生产环境如果站点域名和推流服务器不是同一台机器，必须显式填写，
# 否则用户复制到 OBS 的地址会指向 Web 服务器而不是推流服务器。
#
# OBS 里「服务器」填 rtmp://<RTMP_HOST>:<RTMP_PORT>/<RTMP_APP>，
#      「推流码」填接口返回的 streamKey。
RTMP_HOST=
RTMP_PORT=1935
RTMP_APP=live
# HLS 播放地址前缀（含协议）。留空时使用当前站点地址。
# 若用 CDN 分发播放流，这里填 CDN 域名，例如 https://cdn.example.com
HLS_BASE_URL=
