# 环境配置
.env
# 含真实密钥的临时 env 备份（切勿提交，提交即泄露）
.env.e2e-bak
.env.*.bak
# P2-73：.env 写通道的自动备份/原子写产物（migration.js 的 .env.bak.<ts>、
# setup.js 的 .env.broken-<ts>、写盘失败的 .env.tmp 及带 pid+时间戳的并发安全
# 临时名 .env.<pid>-<ts>.tmp），全部含旧密钥，严禁入库
.env.bak.*
.env.broken-*
.env.tmp
.env.*.tmp
.env.local
.env.*.local
# 运维面板密码哈希（PBKDF2，本地私有；删除后可重新初始化，见 docs/20）
panel/panel-auth.json

# 建站引导隔离状态（仅存引导进度/非敏感草稿，非站点配置）
setup-wizard.json

# 依赖
node_modules/

# 运行时数据
server/session.json
server/data/activation-codes.json
*.json.bak

# i18n 审计脚本的可再生成产物（node server/scripts/audit-i18n-full.js 随时重建）
server/scripts/i18n-missing.json

# 备份
backup/
*.sql

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 敏感凭证文件
server/cookie*.txt
server/tc*.txt

# Windows 误重定向产物
nul

# 测试工具
tools/

# AI 一次性辅助脚本（已从 server/ 迁出，非项目运行所需，不纳入版本控制）
ai-scratch/

# 运行时日志与备份目录
logs/
backups/

# 上传目录（保留目录结构）
uploads/profile/photos/*
uploads/profile/videos/*
!uploads/profile/photos/.gitkeep
!uploads/profile/videos/.gitkeep

# ===== 仓库卫生收口（P2-65，2026-09-13）=====
# 运行时生成资产目录（头像缓存/相册图片等用户数据），永不入库
/assets/
# 浏览器截图调试产物
/captures/
# 用户上传内容（头像/直播截图；已跟踪的样例文件不受影响）
/uploads/avatars/*
/uploads/live/*
# Jest 覆盖率本地产物（CI 上传 lcov 已足够）
server/coverage/
# 性能优化前的文件备份快照
/.perf-backup/
# 浏览器审计输出产物
server/browser-audit/
# AI 助手本地状态目录
/.workbuddy/
/.codebuddy/
