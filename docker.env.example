# ==================== 境途同游 Web — Docker Compose 环境变量 ====================
# 使用方式（二选一，推荐第一种，不会触碰 Node 的 .env）：
#   docker compose --env-file docker.env.example up -d --build
# 或复制为 .env.docker 后：
#   cp docker.env.example .env.docker && docker compose --env-file .env.docker up -d --build
#
# 注意：compose 默认会读取项目根目录的 .env（Node 用的）。本文件通过 --env-file
# 显式指定，优先级更高且互不干扰。JINGTU_DB_* 与 Node 的 MYSQL_* 是两套变量，
# 不要混用。

# ---- 数据库（容器内通过服务名 db 访问） ----
# 两项口令为必填：compose 用 ${VAR:?} 校验，缺失或注释掉会直接报错拒启，
# 不再有 change_me 占位默认值（防止弱口令静默上线）。
JINGTU_DB_ROOT_PASSWORD=请改为强随机密码
JINGTU_DB_NAME=jingtu_group
JINGTU_DB_USER=jingtu_user
JINGTU_DB_PASSWORD=请改为强随机密码
# P3-19：可选 SQLite 嵌入式模式——设为 sqlite 时启用 server/db.js 的 SQL 重写层
# （就地 patch mysql2/promise，改用 Node 内置 node:sqlite DatabaseSync）。
# ⚠️ Docker 镜像默认 MySQL（上方 JINGTU_DB_* 必填，compose 用 ${VAR:?} 校验）；
#   切换 SQLite 需自行改 compose 删除/绕过 db 服务与必填校验，且 Session 回退 MemoryStore。
#   详见 docs/27 §11（开发/单机/演示用途，不建议生产）。
JINGTU_DB_ENGINE=
# SQLite 库文件路径，默认 server/data/jingtu.sqlite（容器内 /app/server/data/jingtu.sqlite，
# server/data 已由 compose 挂载具名卷持久化）。
# 如需放到其他路径请用绝对路径覆盖，例如 /app/data/jingtu.sqlite。
JINGTU_SQLITE_PATH=

# ---- 必填密钥（缺失会导致容器启动失败） ----
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=请替换为至少48字节随机十六进制
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  （64位十六进制）
ENCRYPT_KEY=请替换为64位十六进制随机串

# ---- 应用端口与绑定地址（宿主:容器，容器固定3456） ----
# APP_BIND 默认 127.0.0.1：只监听回环，公网流量必须经本机 Nginx/宝塔反代进来（推荐姿势）。
# 仅当你确认服务器防火墙/安全组已管控、需要无反代直连暴露时才设 0.0.0.0，
# 且此时务必把下方 TRUST_PROXY 设为 0。
APP_BIND=127.0.0.1
APP_PORT=3456

# ---- 业务配置（可选） ----
# 生产必须设置，多个域名用英文逗号分隔，例如 https://jingtu.example.com,https://www.example.com
CORS_ORIGINS=
GROUP_ID=
VRC_API_KEY=
VRC_GROUP_URL=
# P3-19：VRChat 数据源附加（可选），留空代码回退默认值
# （VRC_USER_AGENT 默认 JingTuWeb/1.3.0；VRCX_SEARCH_URL 默认 https://requi.dev/vrcx_search.php）
VRC_USER_AGENT=
VRCX_SEARCH_URL=
KOOK_URL=
OOPZ_URL=
LOG_LEVEL=INFO

# ---- 站点地址与恢复口令（P2-74 新增透传） ----
# 站点对外地址：邮件内链接、sitemap 等使用；留空则代码回退本地默认值，生产务必设置完整 URL
APP_URL=
# P3-19：站点地址补充三件套（可选）——SITEMAP_BASE_URL 优先、APP_URL 次之、
# APP_BASE_URL 最后回退（server/routes/sitemap.js:18）；WS_URL 下发前端 WS 地址
# （server/routes/stats.js:21，留空前端按当前页面自动探测）
SITEMAP_BASE_URL=
APP_BASE_URL=
WS_URL=
# 数据库恢复接口（/api/system/db-recover 写接口）口令；留空时相关接口直接返回 503（安全默认）。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECOVERY_TOKEN=

# ---- 激活码离线存储（P2-102 新增透传；可选） ----
# 默认落容器内 /app/server/data/activation-codes.json（server/data 已由 compose 挂载
# data:/app/server/data 具名卷持久化，容器重建不丢失；Dockerfile 已 chown 目录，node 可写）。
# 如需放到其他路径，用绝对路径覆盖，例如 /app/uploads/activation-codes.json。
ACTIVATION_CODES_FILE=

# ---- 数据保留策略（P3-19 新增透传；server/tasks.js 每日清理） ----
# 留空代码回退默认值（FILE=90 / NOTIFICATION=30 / BACKUP=7，见 tasks.js:58/144/172）。
# 仅 auto_ 前缀的定时备份受 BACKUP_RETENTION_DAYS 约束，手动备份不删。
FILE_RETENTION_DAYS=
NOTIFICATION_RETENTION_DAYS=
BACKUP_RETENTION_DAYS=

# ---- 运维面板（说明） ----
# 容器镜像不包含运维面板（Dockerfile 仅 COPY server/ 运行所需，未含 panel/），
# /ops 反向代理在容器内不可用 → 容器部署无需配置 PANEL_PORT（裸机/宝塔部署在根 .env.example 配置）。

# ---- 邮件通知（可选；SMTP_HOST 留空则全部邮件功能静默跳过） ----
# 口令变量 SMTP_PASS 优先，SMTP_PASSWORD 为历史兼容别名（二者只需填其一，见 server/mailer.js）
SMTP_HOST=
SMTP_PORT=587
# true = TLS 直连（通常 465 端口）；留空/false = STARTTLS（通常 587）
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM=
# 接收安全告警/工单通知的管理员邮箱
ADMIN_EMAIL=

# ---- 反代与客户端 IP（TRUST_PROXY）----
# P3-25：compose 已参数化为 ${TRUST_PROXY:-0}（安全默认=不信任代理，与 server.js 一致），
# 在本文件填值即可生效，无需再改 compose：
#   设为 1：app 前面有一层本机 Nginx/宝塔反代——标准公网部署姿势（必须显式设 1）。
#   保持 0（默认）：前面没有反代、APP_BIND=0.0.0.0 直连公网（不信任任何代理头）。
#   设为 2：反代前还有 CDN 等一层（按实际跳数）。
# 跳数错了的后果：req.ip、按 IP 的登录限流与安全告警取到的客户端 IP 不正确，
# 伪造 X-Forwarded-For 甚至可绕过限流/黑名单，务必与真实拓扑一致。
TRUST_PROXY=0

# ---- Redis 缓存（可选，留空即完全关闭） ----
# 未设置 REDIS_HOST 时，缓存/限流计数/CSRF 全部走进程内实现，行为与未接入 Redis 一致。
# 开启后限流计数与 CSRF token 变为跨实例共享态。默认 compose 编排不含 Redis 服务，
# 如需请在 docker-compose.yml 里自行添加 redis 服务，并把 REDIS_HOST 设为该服务名（如 redis）。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 直播推流（可选，留空则使用当前站点地址） ----
RTMP_HOST=
RTMP_PORT=1935
RTMP_APP=live
HLS_BASE_URL=
