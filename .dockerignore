# ==================== .dockerignore ====================
# 避免把无关/敏感/体积大的内容送进构建上下文

# 依赖与构建产物
node_modules
server/node_modules
**/node_modules

# 版本控制
.git
.gitignore

# 本地环境 / 密钥（容器运行时通过 env 或挂载注入，不要打包）
.env
.env.*
!.env.example
*.local

# 日志与运行产物
logs
*.log
err.log
out.log
local-server.log
mariadb-local.log
_srv3*.log

# 上传与备份（运行时用卷挂载）
uploads
backups
backup
__pycache__
*.pyc
_removed-bats
_jt_trash

# Compose 持久数据目录（STORAGE_ROOT 默认 ./docker-data）：宿主机数据不进构建上下文，
# 否则 docker-data 一旦挂载 MySQL/uploads 等 GB 级数据，docker build 会全量传输拖垮构建
docker-data
docker-data/**

# 文档与辅助脚本（不影响运行）
docs
tools
ai-scratch
*.md
!README.md

# 测试与 CI
coverage
junit.xml
*.test.js
test_*.js

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.idea
.vscode
.workbuddy
